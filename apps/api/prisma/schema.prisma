generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String
  isMember Boolean @default(false)
  orders   Order[]
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  productName String
  unitPrice   Int
  quantity    Int
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())

  @@index([userId])
}
